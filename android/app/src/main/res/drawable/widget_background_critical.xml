<?xml version="1.0" encoding="utf-8"?>
<!-- Swapped in for widget_background.xml when the chain is inside its final
     minute - see ChainWidgetProvider.buildViews(). Mirrors the same red the
     in-app shell uses for :root[data-chain-danger="critical"] (shell.css). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/ic_launcher_background" />
    <corners android:radius="22dp" />
    <stroke android:width="1.5dp" android:color="#59FF5D68" />
</shape>
