generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FactionRole {
  OWNER
  ADMINISTRATOR
  CHAIN_MANAGER
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum ApiCredentialStatus {
  ACTIVE
  PAUSED
  INVALID
  DISCONNECTED
}

enum LicenseStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
  REJECTED
}

enum LicenseTerm {
  PERMANENT
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum AccessRequestStatus {
  PENDING
  INFORMATION_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ChainStatus {
  ACTIVE
  COOLDOWN
  COMPLETED
  BROKEN
}

enum RewardSchemeStatus {
  ACTIVE
  ARCHIVED
}

enum RewardKind {
  ITEM
  CURRENCY
  POINTS
  CUSTOM
}

enum SnapshotStatus {
  FINAL
  SUPERSEDED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  HELD
  WAIVED
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model User {
  id                    String               @id @default(uuid()) @db.Uuid
  tornUserId            Int                  @unique
  name                  String
  avatarUrl             String?
  isPlatformAdmin       Boolean              @default(false)
  lastAuthenticatedAt   DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  memberships           FactionMembership[]
  sessions              Session[]
  submittedRequests     AccessRequest[]       @relation("AccessRequestSubmitter")
  reviewedRequests      AccessRequest[]       @relation("AccessRequestReviewer")
  approvedLicenses      FactionLicense[]      @relation("LicenseApprover")
  processedPayouts      MemberPayout[]        @relation("PayoutProcessor")
  auditEvents           AuditLog[]            @relation("AuditActor")
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, expiresAt])
}

model Faction {
  id                  String                     @id @default(uuid()) @db.Uuid
  tornFactionId       Int                        @unique
  name                String
  tag                 String?
  accentColor         String                     @default("#8BE04E")
  timezone            String                     @default("UTC")
  isDevelopmentTenant Boolean                    @default(false)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  memberships         FactionMembership[]
  apiCredentials      FactionApiCredential[]
  licenses            FactionLicense[]
  accessRequests      AccessRequest[]
  chains              Chain[]
  rewardDefinitions   RewardDefinition[]
  rewardSchemes       RewardScheme[]
  payouts             MemberPayout[]
  auditEvents         AuditLog[]
  syncLogs            SyncLog[]
  settings            FactionSetting[]
}

model FactionMembership {
  id          String           @id @default(uuid()) @db.Uuid
  factionId   String           @db.Uuid
  faction     Faction          @relation(fields: [factionId], references: [id], onDelete: Restrict)
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  role        FactionRole      @default(VIEWER)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([factionId, userId])
  @@index([userId, status])
}

model FactionApiCredential {
  id               String              @id @default(uuid()) @db.Uuid
  factionId        String              @db.Uuid
  faction          Faction             @relation(fields: [factionId], references: [id], onDelete: Restrict)
  ownerTornUserId  Int
  encryptedKey     Bytes
  encryptionIv     Bytes
  keyFingerprint   String              @unique
  keyLastFour      String
  accessType       String
  selections       Json
  status           ApiCredentialStatus @default(ACTIVE)
  lastValidatedAt  DateTime?
  lastSuccessfulAt DateTime?
  lastErrorCode    Int?
  lastErrorAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([factionId, status])
}

model FactionLicense {
  id             String        @id @default(uuid()) @db.Uuid
  factionId      String        @db.Uuid
  faction        Faction       @relation(fields: [factionId], references: [id], onDelete: Restrict)
  status         LicenseStatus @default(PENDING)
  term           LicenseTerm
  reference      String        @unique
  issuedAt       DateTime?
  expiresAt      DateTime?
  approvedById   String?       @db.Uuid
  approvedBy     User?         @relation("LicenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  paymentNotes   String?
  internalNotes  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([factionId, status, expiresAt])
}

model AccessRequest {
  id            String              @id @default(uuid()) @db.Uuid
  factionId     String              @db.Uuid
  faction       Faction             @relation(fields: [factionId], references: [id], onDelete: Restrict)
  submittedById String              @db.Uuid
  submittedBy   User                @relation("AccessRequestSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedById  String?             @db.Uuid
  reviewedBy    User?               @relation("AccessRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  status        AccessRequestStatus @default(PENDING)
  reference     String              @unique
  customerNote  String?
  privateNote   String?
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([factionId, status])
}

model Chain {
  id                    String                    @id @default(uuid()) @db.Uuid
  factionId             String                    @db.Uuid
  faction               Faction                   @relation(fields: [factionId], references: [id], onDelete: Restrict)
  tornChainId           Int
  status                ChainStatus
  currentHits           Int
  maximumHits           Int?
  respect               Decimal?                  @db.Decimal(16, 4)
  timeoutSeconds        Int?
  startedAt             DateTime
  endedAt               DateTime?
  lastSyncedAt          DateTime
  sourcePayload         Json
  assignedSchemeId      String?                   @db.Uuid
  assignedScheme        RewardScheme?             @relation("AssignedScheme", fields: [assignedSchemeId], references: [id], onDelete: SetNull)
  contributions         ChainMemberContribution[]
  rewardSnapshots       ChainRewardSnapshot[]
  syncLogs              SyncLog[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@unique([factionId, tornChainId])
  @@index([factionId, status, startedAt])
  @@index([factionId, endedAt])
}

model ChainMemberContribution {
  id               String                @id @default(uuid()) @db.Uuid
  chainId          String                @db.Uuid
  chain            Chain                 @relation(fields: [chainId], references: [id], onDelete: Restrict)
  tornUserId       Int
  memberName       String
  hits             Int
  respectTotal     Decimal?              @db.Decimal(16, 4)
  respectAverage   Decimal?              @db.Decimal(16, 4)
  attackBreakdown  Json
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  payoutEntries    MemberPayout[]

  @@unique([chainId, tornUserId])
  @@index([tornUserId, chainId])
}

model RewardDefinition {
  id               String             @id @default(uuid()) @db.Uuid
  factionId        String             @db.Uuid
  faction          Faction            @relation(fields: [factionId], references: [id], onDelete: Restrict)
  name             String
  displayUnit      String
  kind             RewardKind         @default(CUSTOM)
  tornItemId       Int?
  decimals         Int                @default(0)
  prefix           String?
  suffix           String?
  isArchived       Boolean            @default(false)
  tierRewards      RewardTierReward[]
  payouts          MemberPayout[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([factionId, name])
  @@index([factionId, isArchived])
}

model RewardScheme {
  id                  String                @id @default(uuid()) @db.Uuid
  factionId           String                @db.Uuid
  faction             Faction               @relation(fields: [factionId], references: [id], onDelete: Restrict)
  name                String
  description         String?
  version             Int                   @default(1)
  status              RewardSchemeStatus    @default(ACTIVE)
  isDefault           Boolean               @default(false)
  tiers               RewardTier[]
  assignedChains      Chain[]               @relation("AssignedScheme")
  rewardSnapshots     ChainRewardSnapshot[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([factionId, name, version])
  @@index([factionId, status, isDefault])
}

model RewardTier {
  id          String             @id @default(uuid()) @db.Uuid
  schemeId    String             @db.Uuid
  scheme      RewardScheme       @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  minimumHits Int
  maximumHits Int?
  label       String
  description String?
  position    Int
  isEnabled   Boolean            @default(true)
  rewards     RewardTierReward[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([schemeId, position])
  @@index([schemeId, minimumHits, maximumHits])
}

model RewardTierReward {
  id                 String           @id @default(uuid()) @db.Uuid
  tierId             String           @db.Uuid
  tier               RewardTier       @relation(fields: [tierId], references: [id], onDelete: Restrict)
  rewardDefinitionId String           @db.Uuid
  rewardDefinition   RewardDefinition @relation(fields: [rewardDefinitionId], references: [id], onDelete: Restrict)
  amount             Decimal          @db.Decimal(18, 4)

  @@unique([tierId, rewardDefinitionId])
}

model ChainRewardSnapshot {
  id              String         @id @default(uuid()) @db.Uuid
  chainId         String         @db.Uuid
  chain           Chain          @relation(fields: [chainId], references: [id], onDelete: Restrict)
  rewardSchemeId  String         @db.Uuid
  rewardScheme    RewardScheme   @relation(fields: [rewardSchemeId], references: [id], onDelete: Restrict)
  schemeName      String
  schemeVersion   Int
  status          SnapshotStatus @default(FINAL)
  calculation     Json
  liabilityTotals Json
  calculatedAt    DateTime       @default(now())
  supersededAt    DateTime?
  payouts         MemberPayout[]

  @@index([chainId, status])
}

model MemberPayout {
  id                  String                   @id @default(uuid()) @db.Uuid
  factionId           String                   @db.Uuid
  faction             Faction                  @relation(fields: [factionId], references: [id], onDelete: Restrict)
  snapshotId          String                   @db.Uuid
  snapshot            ChainRewardSnapshot      @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  contributionId      String                   @db.Uuid
  contribution        ChainMemberContribution  @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  rewardDefinitionId  String                   @db.Uuid
  rewardDefinition    RewardDefinition         @relation(fields: [rewardDefinitionId], references: [id], onDelete: Restrict)
  tornUserId          Int
  memberName          String
  amount              Decimal                  @db.Decimal(18, 4)
  status              PayoutStatus             @default(PENDING)
  processedById       String?                  @db.Uuid
  processedBy         User?                    @relation("PayoutProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  processedAt         DateTime?
  note                String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([snapshotId, contributionId, rewardDefinitionId])
  @@index([factionId, status, createdAt])
  @@index([tornUserId, status])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  factionId      String?  @db.Uuid
  faction        Faction? @relation(fields: [factionId], references: [id], onDelete: Restrict)
  actorId        String?  @db.Uuid
  actor          User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddressHash  String?
  createdAt      DateTime @default(now())

  @@index([factionId, createdAt])
  @@index([action, createdAt])
}

model SyncLog {
  id               String     @id @default(uuid()) @db.Uuid
  factionId        String     @db.Uuid
  faction          Faction    @relation(fields: [factionId], references: [id], onDelete: Restrict)
  chainId          String?    @db.Uuid
  chain            Chain?     @relation(fields: [chainId], references: [id], onDelete: SetNull)
  operation        String
  status           SyncStatus
  recordsProcessed Int        @default(0)
  durationMs       Int?
  apiErrorCode     Int?
  errorCategory    String?
  startedAt        DateTime   @default(now())
  finishedAt       DateTime?

  @@index([factionId, startedAt])
  @@index([status, startedAt])
}

model FactionSetting {
  id         String   @id @default(uuid()) @db.Uuid
  factionId  String   @db.Uuid
  faction    Faction  @relation(fields: [factionId], references: [id], onDelete: Restrict)
  key        String
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([factionId, key])
}

model ApplicationSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
