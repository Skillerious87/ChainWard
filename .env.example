# Leave empty to use the on-device SQLite file created from Settings.
DATABASE_URL=""
# Optional shared/hosted database example:
# DATABASE_URL="postgresql://chainward:chainward@localhost:5432/chainward?schema=public"

# Optional local-file backend. Used when DATABASE_URL is unset.
CHAINWARD_LOCAL_DB_PATH="./data/chainward-local.sqlite"

# Development creates the project-local SQLite file automatically. Set false
# to require manual creation, or true to test a local production build without
# PostgreSQL.
CHAINWARD_LOCAL_TEST_MODE="true"

# Optional override for encrypted local credentials. On Windows the default is
# %LOCALAPPDATA%\Chainward, deliberately outside the project directory.
# CHAINWARD_APP_DATA_DIR="C:\Users\you\AppData\Local\Chainward"

# Required in deployed environments. In local development, leaving this empty
# creates a stable machine-private encryption secret in Chainward AppData.
SESSION_SECRET=""

# Required separately in deployed environments. Local development creates a
# stable machine-private secret in Chainward AppData when this is empty.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
API_KEY_ENCRYPTION_SECRET=""

# Hosted reverse proxies must declare the public application origin instead of
# relying on caller-controlled forwarded host headers. Comma-separate multiple
# origins, including the scheme. Leave empty for direct/local deployments.
CHAINWARD_ALLOWED_ORIGINS=""
# Enable only when direct access to the Next.js origin is blocked and a trusted
# proxy overwrites x-real-ip / x-forwarded-for.
CHAINWARD_TRUST_PROXY_HEADERS="false"

# Development only. Adds deterministic local member/owner buttons to /connect
# and replaces Torn network calls with clearly labelled fixture responses.
# Production builds ignore this flag even if it is accidentally left enabled.
CHAINWARD_OFFLINE_TEST_MODE="false"

# Torn integration
TORN_API_BASE_URL="https://api.torn.com/v2"
TORN_API_COMMENT="chainward"
# Browser requests never use a server-wide Torn key as an identity. This avoids
# every visitor inheriting one shared player's faction or owner privileges.
TORN_LIVE_CACHE_SECONDS="30"
# Hit 10 and each later chain hit restart the timeout, so the ongoing response
# goes stale faster than any other live value and is cached separately. The app
# enforces a conservative five-second floor whatever is configured here. Keep
# this shorter than the 10s active-chain poll: if they are equal, a poll can be served from cache
# and the next real refresh slips a further interval away.
TORN_CHAIN_CACHE_SECONDS="5"
# Completed-chain lists refresh quickly enough to surface a newly ended chain.
# Specific completed reports remain immutable and use the same short local window.
TORN_HISTORY_CACHE_SECONDS="60"
TORN_REQUEST_TIMEOUT_MS="10000"
