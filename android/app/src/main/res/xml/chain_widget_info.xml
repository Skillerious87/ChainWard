<?xml version="1.0" encoding="utf-8"?>
<!-- No updatePeriodMillis: the system's own periodic refresh is capped at a
     30-minute floor and would only ever show a stale snapshot anyway. Every
     update instead comes pushed from the live app - see ChainWidgetPlugin's
     update() - which happens far more often than that whenever the app is
     actually open, and is the only time fresher data even exists. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/chain_widget"
    android:previewLayout="@layout/chain_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
