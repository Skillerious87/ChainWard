# Leave empty to use the on-device SQLite file created from Settings.
DATABASE_URL=""
# Optional shared/hosted database example:
# DATABASE_URL="postgresql://chainward:chainward@localhost:5432/chainward?schema=public"

# Optional local-file backend. Used when DATABASE_URL is unset.
CHAINWARD_LOCAL_DB_PATH="./data/chainward-local.sqlite"

# Use at least 32 random characters in deployed environments. Keep this value
# stable: it encrypts remembered Torn credentials stored by the server.
SESSION_SECRET="replace-with-a-long-random-secret"

# Torn integration
TORN_API_BASE_URL="https://api.torn.com/v2"
TORN_API_COMMENT="chainward"
# Local/server deployment credential. Never prefix this with NEXT_PUBLIC_.
# In production this should be replaced by the encrypted per-faction credential store.
TORN_API_KEY=""
TORN_LIVE_CACHE_SECONDS="30"
# Completed-chain lists refresh quickly enough to surface a newly ended chain.
# Specific completed reports remain immutable and use the same short local window.
TORN_HISTORY_CACHE_SECONDS="60"
TORN_REQUEST_TIMEOUT_MS="10000"
