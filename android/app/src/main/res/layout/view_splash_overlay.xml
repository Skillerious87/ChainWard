<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    android:clickable="true"
    android:focusable="true">

    <com.chainward.app.ChainFieldView
        android:id="@+id/splash_chain_field"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <FrameLayout
            android:id="@+id/splash_icon_group"
            android:layout_width="248dp"
            android:layout_height="248dp">

            <View
                android:id="@+id/splash_ping_ring"
                android:layout_width="192dp"
                android:layout_height="192dp"
                android:layout_gravity="center"
                android:background="@drawable/splash_ping_ring"
                android:alpha="0" />

            <View
                android:id="@+id/splash_glow"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="center"
                android:background="@drawable/splash_glow"
                android:alpha="0" />

            <ImageView
                android:id="@+id/splash_logo"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:src="@drawable/splash_logo"
                android:contentDescription="@null"
                android:alpha="0" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/splash_title_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="INDEPENDENT TORN FACTION PLATFORM"
            android:textColor="@color/splash_tagline_text"
            android:textSize="11sp"
            android:letterSpacing="0.22"
            android:fontFamily="sans-serif"
            android:alpha="0" />

    </LinearLayout>
</FrameLayout>
