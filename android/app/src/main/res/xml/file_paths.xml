<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing in the app currently uses this FileProvider - no camera/filesystem
     plugin is installed - but it stays declared for whenever one is added.
     Scoped to dedicated subfolders rather than the storage/cache roots, so a
     future grantUriPermissions Uri can't expose more than intended. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="my_images" path="Pictures/ChainWard" />
    <cache-path name="my_cache_images" path="shared" />
</paths>