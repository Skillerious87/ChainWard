<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-safe layout for the "ChainWard: Live Chain" home-screen
     widget - see ChainWidgetProvider.java and ChainWidgetPlugin.java. Only a
     small allowlisted set of views/attributes render inside a widget host;
     everything here is a plain LinearLayout/TextView/Chronometer, and only
     text, visibility and the Chronometer base are ever changed at runtime
     (via RemoteViews.set*), so static styling lives directly in this XML. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LIVE CHAIN"
        android:textColor="@color/splash_accent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.16"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/widget_faction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="@color/splash_tagline_text"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Prive Cartel" />

    <LinearLayout
        android:id="@+id/widget_active_group"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/splash_title_text"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            tools:text="47 / 50 hits" />

        <Chronometer
            android:id="@+id/widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/splash_accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_idle"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:textColor="@color/splash_tagline_text"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="No chain running · tap to open" />

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#5C6B63"
        android:textSize="9sp"
        tools:text="Updated 2m ago" />

</LinearLayout>
