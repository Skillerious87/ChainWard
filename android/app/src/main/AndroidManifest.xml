<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- FCM's own display path (app backgrounded/killed) needs these to
             render a proper branded icon/color/channel instead of falling
             back to the full-color adaptive launcher icon, which renders as
             a plain white blob in the status bar. The channel referenced
             here is created up front in MainActivity.onCreate with
             IMPORTANCE_HIGH so the very first notification already gets
             heads-up treatment, rather than whatever default channel
             Firebase's own fallback would otherwise auto-create. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_chainward" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="chainward_default" />

        <!-- launchMode was "singleTask" (the Capacitor template default) until
             it was traced as the cause of a real crash: the WebView's
             Credential Manager passkey bridge opens CredentialSelectorActivity
             as a transient overlay "inside" this task, and on this device
             (and reproducibly, not an isolated fluke) singleTask's task-affinity
             reparenting made WindowManager tear the whole task down - visibly
             logged as "ActivityManager: Killing ... remove task" - the instant
             that overlay closed, instead of resuming MainActivity normally.
             singleTop keeps the one property singleTask was actually here for
             (a second launch, e.g. a notification tap, reuses this instance via
             onNewIntent instead of stacking a duplicate) without singleTask's
             task-affinity reparenting, which is what triggered the bug. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTop"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required at build-manifest level for the runtime POST_NOTIFICATIONS
         prompt (Android 13+/API 33+) that @capacitor/push-notifications
         triggers via requestPermissions() to actually take effect. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
